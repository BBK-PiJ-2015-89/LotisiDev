<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="testapp.silencertestapp.MainActivity">

    <Button
        android:id="@+id/btnsilence"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="29dp"
        android:text="Manual Silence"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:onClick="changeToSilence"
        app:layout_constraintHorizontal_bias="0.102" />

    <Button
        android:id="@+id/button3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/start_service"
        android:onClick="startService"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnsilence"
        app:layout_constraintHorizontal_bias="0.785" />

    <Button
        android:id="@+id/button4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/stop_service"
        android:onClick="stopService"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/button3"
        app:layout_constraintVertical_bias="0.0"
        app:layout_constraintHorizontal_bias="0.177" />
    <EditText
        android:id="@+id/wifinetwork"
        android:layout_width="166dp"
        android:layout_height="42dp"
        android:ems="10"
        android:inputType="textPersonName"
        android:hint="WiFi Network"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="181dp" />
    <EditText
        android:id="@+id/start_time"
        android:layout_width="62dp"
        android:layout_height="40dp"
        android:ems="10"
        android:inputType="time"
        android:hint="start"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="185dp"
        app:layout_constraintLeft_toRightOf="@+id/wifinetwork" />
    <EditText
        android:id="@+id/end_time"
        android:layout_width="72dp"
        android:layout_height="40dp"
        android:ems="10"
        android:inputType="time"
        android:hint="End"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="185dp"
        android:layout_marginStart="225dp"
        android:layout_marginLeft="225dp" />


    <Button
        android:id="@+id/add"
        android:layout_width="88dp"
        android:layout_height="48dp"
        android:text="add"
        android:onClick="add"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="189dp"
        android:layout_marginRight="5dp"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginEnd="5dp" />

    <Button
        android:id="@+id/silencetwobutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SilenceTwo"
        android:onClick="testMethod"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@+id/btnsilence"
        app:layout_constraintBottom_toTopOf="@+id/button3"
        app:layout_constraintTop_toTopOf="parent" />

    <ListView
        android:id="@+id/item_List"
        android:layout_width="361dp"
        android:layout_height="203dp"
        android:layout_marginTop="69dp"

        app:layout_constraintTop_toBottomOf="@+id/wifinetwork"

        app:layout_constraintHorizontal_bias="0.0"
        tools:layout_editor_absoluteX="0dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WiFi Network Name"
        android:layout_marginTop="44dp"
        app:layout_constraintTop_toBottomOf="@+id/wifinetwork"
        android:windowSoftInputMode="adjustPan"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginStart="16dp" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="66dp"
        android:layout_height="17dp"
        android:text="Start Time"
        app:layout_constraintLeft_toRightOf="@+id/textView"
        android:layout_marginLeft="75dp"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/add"/>

    <TextView
        android:id="@+id/textView3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End Time"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@+id/add"
        android:layout_marginRight="8dp"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginEnd="8dp" />

    <android.support.constraint.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guideline3"
        app:layout_constraintGuide_begin="20dp"
        android:orientation="vertical"
        tools:layout_editor_absoluteY="0dp"
        tools:layout_editor_absoluteX="20dp" />

    <CheckBox
        android:id="@+id/sunCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SU"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="241dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />

    <CheckBox
        android:id="@+id/satCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="202dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />

    <CheckBox
        android:id="@+id/friCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="F"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="162dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />

    <CheckBox
        android:id="@+id/thuCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="121dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />

    <CheckBox
        android:id="@+id/wedCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="W"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />

    <CheckBox
        android:id="@+id/tuCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="42dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp"/>

    <CheckBox
        android:id="@+id/monCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="0dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="223dp" />


</android.support.constraint.ConstraintLayout>


