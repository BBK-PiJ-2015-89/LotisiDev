<?xml version="1.0" encoding="utf-8"?>
<android.support.constraint.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="testapp.silencertestapp.MainActivity">


    <Button
        android:id="@+id/add"
        android:layout_width="88dp"
        android:layout_height="52dp"
        android:text="add"
        android:onClick="add"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="152dp"
        android:layout_marginRight="5dp"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginEnd="5dp" />

    <TextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WiFi Network Name"
        android:windowSoftInputMode="adjustPan"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginStart="16dp"
        tools:layout_constraintTop_creator="1"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/monCheckbox" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="wrap_content"
        android:layout_height="17dp"
        android:layout_marginRight="30dp"
        android:text="Start/End Time"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="259dp"
        android:layout_marginEnd="30dp" />

    <android.support.constraint.Guideline
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/guideline3"
        android:orientation="vertical"
        tools:layout_editor_absoluteY="0dp"
        tools:layout_editor_absoluteX="-358dp" />

    <CheckBox
        android:id="@+id/sunCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SU"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="241dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="241dp" />


    <CheckBox
        android:id="@+id/satCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="S"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="202dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="202dp" />

    <CheckBox
        android:id="@+id/friCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="F"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="162dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="162dp" />

    <CheckBox
        android:id="@+id/thuCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="121dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="121dp" />

    <CheckBox
        android:id="@+id/wedCheckBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="W"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="80dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="80dp" />

    <CheckBox
        android:id="@+id/tuCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginLeft="42dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp"
        android:layout_marginStart="42dp" />

    <CheckBox
        android:id="@+id/monCheckbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="M"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="216dp" />

    <TimePicker
        android:id="@+id/startPicker"
        android:layout_width="0dp"
        android:layout_height="0dp"

        android:timePickerMode="spinner"
        app:layout_constraintHorizontal_bias="0.484"
        app:layout_constraintLeft_toLeftOf="@+id/endPicker"
        app:layout_constraintRight_toRightOf="@+id/endPicker"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintRight_creator="1"
        tools:layout_constraintBottom_creator="1"
        app:layout_constraintBottom_toBottomOf="@+id/textView5"
        android:layout_marginTop="28dp"
        tools:layout_constraintLeft_creator="1"
        android:layout_marginBottom="28dp"
        app:layout_constraintTop_toTopOf="@+id/resetbutton" />


    <TimePicker
        android:id="@+id/endPicker"
        android:layout_width="200dp"
        android:layout_height="100dp"

        android:layout_marginTop="97dp"
        android:timePickerMode="spinner"
        app:layout_constraintHorizontal_bias="0.012"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textView4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Time"
        app:layout_constraintRight_toLeftOf="@+id/button"
        tools:layout_constraintRight_creator="1"
        tools:layout_constraintBottom_creator="1"
        app:layout_constraintBottom_toTopOf="@+id/endPicker"
        android:layout_marginEnd="26dp" />

    <TextView
        android:id="@+id/textView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="End Time"
        app:layout_constraintLeft_toLeftOf="@+id/textView4"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintBottom_creator="1"
        app:layout_constraintBottom_toBottomOf="@+id/mode_button"
        app:layout_constraintTop_toBottomOf="@+id/mode_button" />

    <ListView
        android:id="@+id/item_List"
        android:layout_width="0dp"
        android:layout_height="0dp"

        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        tools:layout_constraintRight_creator="1"
        tools:layout_constraintLeft_creator="1"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintBottom_creator="1"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView" />

    <Button
        android:id="@+id/resetbutton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:onClick="resetSystem"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintRight_creator="1"
        android:layout_marginEnd="5dp"
        app:layout_constraintRight_toRightOf="parent"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/wiFiSpinner"
        android:layout_width="240dp"
        android:layout_height="27dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="16dp"
        app:layout_constraintLeft_toLeftOf="parent"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp" />

    <ToggleButton
        android:id="@+id/mode_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ToggleButton"
        android:textOff="Silent"
        android:textOn="Vibrate"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintRight_creator="1"
        app:layout_constraintRight_toRightOf="@+id/button"
        app:layout_constraintTop_toBottomOf="@+id/button"
        tools:layout_constraintLeft_creator="1"
        app:layout_constraintLeft_toLeftOf="@+id/button" />

    <Button
        android:id="@+id/button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Help"
        tools:layout_constraintTop_creator="1"
        tools:layout_constraintRight_creator="1"
        app:layout_constraintRight_toRightOf="@+id/resetbutton"
        app:layout_constraintTop_toBottomOf="@+id/resetbutton"
        tools:layout_constraintLeft_creator="1"
        app:layout_constraintLeft_toLeftOf="@+id/resetbutton"
        android:onClick="helpSection"/>

</android.support.constraint.ConstraintLayout>


